# Optional. Pin canonical/og/json-ld origin instead of using window.location.origin.
# Leave unset so each GHL / preview / staging domain rewrites itself.
# Production DNS cutover: unset, or set to https://montfortre.com
# VITE_PUBLIC_SITE_URL=https://your-staging-domain.com

# Supabase CMS (Lovable / admin dashboard). Omit both URL + key to keep static listings + blog.
# Never put the service-role key here — publishable/anon key only.
# Lovable often names the key PUBLISHABLE; classic docs use ANON — the app accepts either.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Local only — never enable on Lovable production:
# VITE_ADMIN_DEV_BYPASS=true

# Google reviews need NO client env vars. They are synced into Supabase twice a
# week by a pg_cron + pg_net job (supabase/migrations/20260828100100_*.sql).
# Set up once, server-side only:
#   select vault.create_secret('<server-key>', 'google_places_api_key');
#   update public.google_review_stats set place_id = 'ChIJ...' where id = 1;
# That key must NOT be referrer-restricted (Postgres sends no referrer).
